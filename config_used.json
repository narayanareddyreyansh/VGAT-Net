{
  "experiment": "vgatnet_roseo",
  "seed": 2,
  "data": {
    "root": "/kaggle/input/datasets/naruka/vgatnet-roseo/datasets/ROSE-O",
    "train_split": "./data/splits/roseo_train.txt",
    "val_split": "./data/splits/roseo_val.txt",
    "test_split": "./data/splits/roseo_test.txt",
    "image_size": 512,
    "clip_limit": 2.0,
    "num_workers": 4
  },
  "model": {
    "name": "vgatnet",
    "in_channels": 1,
    "base_channels": 64,
    "encoder_depth": 4,
    "embed_dim": 512,
    "tca_depth": 6,
    "tca_heads": 8,
    "patch_size": 2,
    "vgfa_heads": 8
  },
  "loss": {
    "lambda1": 1.0,
    "lambda2": 0.8,
    "topo_iters": 10
  },
  "optim": {
    "optimizer": "adam",
    "lr": 0.0001,
    "weight_decay": 1e-05,
    "scheduler": "cosine",
    "batch_size": 8,
    "epochs": 100,
    "early_stopping_patience": 15,
    "amp": true
  },
  "eval": {
    "threshold": 0.5,
    "metrics": [
      "DSC",
      "IoU",
      "SE",
      "SP",
      "HD95"
    ]
  },
  "output_dir": "./runs/vgatnet_roseo"
}